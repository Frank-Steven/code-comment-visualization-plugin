{
  "name": "comment-sidebar",
  "displayName": "Comment Sidebar",
  "description": "在侧边栏实时展示代码文档，支持 Java / TypeScript / JavaScript，支持双向联动导航",
  "version": "0.9.78",
  "publisher": "xiaowuDev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dawdadsd/Code-comment-visualization-plugin.git",
    "homepage": "https://github.com/dawdadsd/Code-comment-visualization-plugin#readme"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "doc",
    "documentation",
    "sidebar",
    "java",
    "typescript",
    "javascript"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:markdown",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:objective-c",
    "onLanguage:kotlin",
    "onLanguage:scala",
    "onLanguage:groovy",
    "onLanguage:python",
    "onLanguage:ruby",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:php",
    "onLanguage:lua",
    "onLanguage:dart",
    "onLanguage:swift",
    "onLanguage:r",
    "onLanguage:vue",
    "onLanguage:svelte"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commentSidebarExplorer",
          "title": "Doc Sidebar",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "commentSidebarExplorer": [
        {
          "icon": "media/icon.svg",
          "type": "webview",
          "id": "commentSidebar",
          "name": "文档导航"
        }
      ]
    },
    "commands": [
      {
        "command": "commentSidebar.refresh",
        "title": "刷新文档侧边栏",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run sync:wasms && pnpm run sync:vendors && pnpm run compile",
    "sync:wasms": "node scripts/sync-wasms.js",
    "sync:vendors": "node scripts/sync-vendors.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "pnpm run compile",
    "test": "jest",
    "test:unit": "jest fieldType tagParser",
    "test:parser": "jest parser",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "katex": "^0.18.1",
    "mermaid": "^10.9.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.0"
  },
  "extensionDependencies": [],
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  }
}